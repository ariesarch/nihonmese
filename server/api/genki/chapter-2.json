                            "speech": "メアリー　ハート　です。　あのう、　リゅがくせい　ですか。"
                        },
                        {
                            "audio_start": 20,
                            "audio_end": 27,
                            "speaker": "たけし",
                            "speech": "いいえ、にほんじん　です。"
                        },
