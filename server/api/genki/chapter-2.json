                            "speech": "そですか。なんねんせい　ですか。"
                        },
                        {
                            "audio_start": 35,
                            "audio_end": 39,
                            "speaker": "たけし",
                            "speech": "よねんせい　です。"
                        }
                    ]
                },
                {
                    "dialogue_id": 2,
                    "format": "dialogue",
                    "title": "Marry introduces herself to everyone.",
                    "audio_start": 0,
                    "audio_end": 0,
                    "speeches": [
                        {
                            "speaker": "メアリー",
                            "speech": "はじめまして。メアリーハート　です。"
                        },
                        {
                            "speaker": "メアリー",
                            "speech": "アリぞな　だいがく　の　がくせいです。にねんせい　です。"
                        },
                        {
                            "speaker": "メアリー",
                            "speech": "せんこは　にほんご　です。じゅきゅさい　です。"
                        },
                        {
                            "speaker": "メアリー",
                            "speech": "よろしく　おねがい　します。"
                        }
                    ]
                }
